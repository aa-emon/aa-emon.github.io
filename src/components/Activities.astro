---
/** Memberships and roles outside the degree and the lab. */
import Block from './Block.astro';
import { activityList } from '../data';
import { formatPeriod } from '../lib/format';
---

<Block id="activities" index="05" title="Activities">
  <ol class="rows">
    {
      activityList.map((entry) => (
        <li class="act">
          <span class="mono act__years">{formatPeriod(entry.start, entry.end)}</span>
          <div>
            <p class="act__role">{entry.role}</p>
            <p class="mono act__org">
              {entry.url ? (
                <a class="ulink" href={entry.url} target="_blank" rel="noopener noreferrer">
                  {entry.org}
                </a>
              ) : (
                entry.org
              )}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Block>

<style>
  .act {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.15rem;
  }

  .act__years {
    padding-top: 0.15rem;
    white-space: nowrap;
  }

  .act__role {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
  }

  .act__org {
    margin-top: 0.15rem;
    line-height: 1.6;
  }

  .act__org a {
    color: var(--ink);
  }

  @media (min-width: 560px) {
    .act {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
