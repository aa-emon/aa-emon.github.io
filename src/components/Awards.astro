---
/**
 * Competition results, grouped by level so the progression campus → province →
 * country is legible at a glance.
 */
import SectionHeader from './SectionHeader.astro';
import { awardCount, awardGroups, projects } from '../data';
import { formatDate, formatDateNumeric } from '../lib/format';

const projectTitle = (id: string) => projects.find((project) => project.id === id)?.title;
---

<section id="awards" aria-labelledby="awards-heading">
  <div class="wrap">
    <SectionHeader
      id="awards"
      title="Awards"
      count={`${awardCount} results`}
      lead="Three stages of the same idea, taken through a campus round, a provincial final, and a national one."
    />

    {
      awardGroups.map((group) => (
        <div class="group">
          <h3 class="group__head">
            <span>{group.label}</span>
            <span class="group__count">{String(group.items.length).padStart(2, '0')}</span>
          </h3>

          <ol class="awards">
            {group.items.map((award) => (
              <li class="award">
                <span class="award__date">{formatDateNumeric(award.date)}</span>

                <div class="award__body">
                  <p class="award__prize">{award.prize}</p>
                  <p class="award__title">{award.title}</p>
                  <p class="award__issuer">{award.issuer}</p>

                  <p class="award__meta">
                    {award.reference && (
                      <span>
                        {award.reference.label} <span class="award__ref">{award.reference.value}</span>
                      </span>
                    )}
                    {award.issued && <span>Issued {formatDate(award.issued)}</span>}
                    {award.projectId && projectTitle(award.projectId) && (
                      <a class="award__project" href="#projects">
                        {projectTitle(award.projectId)}
                      </a>
                    )}
                  </p>

                  {award.note && <p class="award__note">{award.note}</p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>
</section>

<style>
  .group + .group {
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
  }

  .group__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.55rem;
    border-top: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .group__count {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .awards {
    border-bottom: 1px solid var(--rule);
  }

  .award {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    padding-block: clamp(1.15rem, 2.4vw, 1.6rem);
    border-bottom: 1px solid var(--rule-soft);
  }

  .award:last-child {
    border-bottom: 0;
  }

  .award__date {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2rem;
  }

  .award__body {
    min-width: 0;
  }

  .award__prize {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
    line-height: 1.3;
  }

  .award__title {
    margin-top: 0.15rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 62ch;
    text-wrap: pretty;
  }

  .award__issuer {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: 62ch;
  }

  .award__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-top: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .award__ref {
    color: var(--ink);
  }

  .award__project {
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .award__project:hover {
    color: var(--accent);
  }

  .award__note {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  @media (min-width: 720px) {
    .award {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
</style>
