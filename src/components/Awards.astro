---
import Block from './Block.astro';
import { awardList } from '../data';
import { formatDate, levelLabel } from '../lib/format';
---

<Block id="awards" index="02" title="Awards" count={`${awardList.length} results`}>
  <ol class="rows">
    {
      awardList.map((award) => (
        <li class="award">
          <span class="mono award__date">{formatDate(award.date)}</span>

          <div class="award__body">
            <p class="award__prize">
              {award.prize}
              <span class="mono award__level">{levelLabel(award.level)}</span>
            </p>
            <p class="award__title">{award.title}</p>
            <p class="mono award__issuer">
              {award.issuer}
              {award.reference && <> · {award.reference.label} {award.reference.value}</>}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Block>

<style>
  .award {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.15rem;
  }

  .award__date {
    padding-top: 0.15rem;
  }

  .award__prize {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.1rem 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
  }

  .award__level {
    color: var(--accent);
  }

  .award__title {
    margin-top: 0.1rem;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .award__issuer {
    margin-top: 0.25rem;
    line-height: 1.6;
  }

  @media (min-width: 560px) {
    .award {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
