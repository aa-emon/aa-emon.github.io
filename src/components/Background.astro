---
/**
 * Background artwork: two hairlines and a quarter circle, drawn in the rule
 * colour so they sit just above the paper and never compete with text.
 * Fixed, non-interactive, hidden in print.
 */
---

<div class="art" aria-hidden="true">
  <svg viewBox="0 0 1440 900" preserveAspectRatio="xMaxYMin slice" fill="none">
    <g stroke="currentColor" stroke-width="1">
      <circle cx="1395" cy="120" r="330" />
      <circle cx="1395" cy="120" r="210" />
    </g>
  </svg>
</div>

<style>
  .art {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    color: var(--rule);
    opacity: 0.75;
    overflow: hidden;
  }

  .art svg {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 640px) {
    .art {
      opacity: 0.5;
    }

    .art svg {
      /* Pull the rings toward the corner so they stay out of the text column. */
      transform: translate(14%, -8%);
    }
  }

  @media print {
    .art {
      display: none;
    }
  }
</style>
