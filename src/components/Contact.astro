---
import Block from './Block.astro';
import Icon from './Icon.astro';
import { profile, site } from '../data';

const email = profile.links[0];
---

<Block id="contact" index="04" title="Contact">
  <a class="contact__mail" href={email.href}>
    <span>{email.label}</span>
    <Icon size={16} class="contact__icon" />
  </a>

  <p class="mono contact__where">{site.location}</p>
</Block>

<style>
  .contact__mail {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.4rem;
    font-size: clamp(1.125rem, 3.4vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--ink);
    padding-bottom: 0.2rem;
    border-bottom: 1px solid var(--rule);
    transition:
      color var(--med) var(--ease),
      border-color var(--med) var(--ease);
    word-break: break-word;
  }

  .contact__mail:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .contact__mail :global(.contact__icon) {
    margin-top: 0.3em;
    color: var(--accent);
    transition: transform var(--med) var(--ease);
    flex: none;
  }

  .contact__mail:hover :global(.contact__icon) {
    transform: translate3d(2px, -2px, 0);
  }

  .contact__where {
    margin-top: 0.85rem;
  }
</style>
