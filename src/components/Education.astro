---
import Block from './Block.astro';
import { degreeList } from '../data';
import { formatPeriod } from '../lib/format';
---

<Block id="education" index="01" title="Education">
  <ol class="rows">
    {
      degreeList.map((degree) => (
        <li class="edu">
          <span class="mono edu__years">{formatPeriod(degree.start, degree.end)}</span>
          <div>
            <p class="edu__degree">{degree.degree}</p>
            <p class="mono edu__org">
              {degree.org}
              {degree.location && <> · {degree.location}</>}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Block>

<style>
  .edu {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.15rem;
  }

  .edu__years {
    padding-top: 0.15rem;
  }

  .edu__degree {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
    line-height: 1.4;
  }

  .edu__org {
    margin-top: 0.15rem;
    line-height: 1.6;
  }

  @media (min-width: 560px) {
    .edu {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1.25rem;
    }
  }
</style>
