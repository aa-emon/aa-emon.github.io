---
/**
 * One reverse-chronological timeline for degrees, positions, and anything else
 * with a period. Dates come from data; a missing date renders as a note
 * instead of an invented range.
 */
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
import { timeline } from '../data';
import { formatPeriod } from '../lib/format';
import type { ExperienceKind } from '../lib/types';

const KIND_LABEL: Record<ExperienceKind, string> = {
  education: 'Education',
  research: 'Research',
  industry: 'Industry',
  teaching: 'Teaching',
  service: 'Service',
};

const kindLabel = (kind: ExperienceKind) => KIND_LABEL[kind];
---

<section id="experience" aria-labelledby="experience-heading">
  <div class="wrap">
    <SectionHeader
      id="experience"
      title="Experience"
      count={`${timeline.length} entries`}
      lead="Both degrees were taken in the same department; the research has always sat next to the coursework."
    />

    <ol class="timeline">
      {
        timeline.map((item) => (
          <li class="entry">
            <div class="entry__when">
              {item.start || item.end
                ? formatPeriod(item.start, item.end)
                : (item.periodNote ?? '')}
            </div>

            <div class="entry__what">
              <p class="entry__kind">{kindLabel(item.kind)}</p>
              <h3 class="entry__role">{item.role}</h3>

              <p class="entry__org">
                {item.orgUrl ? (
                  <a
                    class="ulink"
                    href={item.orgUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {item.org}
                  </a>
                ) : (
                  item.org
                )}
                {item.location && <span class="entry__loc"> · {item.location}</span>}
              </p>

              {item.summary && <p class="entry__summary">{item.summary}</p>}

              {item.tags && item.tags.length > 0 && (
                <p class="entry__tags">{item.tags.join(' · ')}</p>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <p class="exp-foot">
      <Icon name="dot" size={6} />
      <span>Full CV available on request.</span>
    </p>
  </div>
</section>

<style>
  .timeline {
    border-bottom: 1px solid var(--rule);
  }

  .entry {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    padding-block: clamp(1.35rem, 2.8vw, 1.9rem);
    border-top: 1px solid var(--rule);
  }

  .entry__when {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.15rem;
    white-space: nowrap;
  }

  .entry__what {
    min-width: 0;
  }

  .entry__kind {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .entry__role {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.018em;
    line-height: 1.3;
    color: var(--ink);
  }

  .entry__org {
    margin-top: 0.2rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .entry__loc {
    color: var(--muted);
  }

  .entry__summary {
    margin-top: 0.5rem;
    max-width: 60ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }

  .entry__tags {
    margin-top: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .exp-foot {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .exp-foot :global(svg) {
    color: var(--rule);
  }

  @media (min-width: 720px) {
    .entry {
      grid-template-columns: 10.5rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
</style>
