---
import { site } from '../data';

const year = new Date().getFullYear();
const updated = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' }).format(
  new Date(`${site.updated}-01T00:00:00Z`),
);
---

<footer class="foot">
  <div class="page">
    <div class="foot__inner">
      <p>© {year} {site.name}</p>
      <p>Updated {updated}</p>
      <p class="foot__type">Archivo &amp; JetBrains Mono</p>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(2.75rem, 6.5vw, 4rem);
  }

  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.75rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.9rem;
    padding-bottom: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .foot__type {
    margin-left: auto;
  }

  @media (max-width: 560px) {
    .foot__type {
      margin-left: 0;
    }
  }
</style>
