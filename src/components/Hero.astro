---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { profile, site } from '../data';

const [lede] = profile.bio;
---

<header class="hero">
  <div class="hero__text">
    <p class="hero__role">{profile.role}</p>
    <h1 class="hero__name">{profile.name}</h1>
    <p class="hero__affil">{site.location}</p>

    <p class="hero__bio">{lede}</p>

    <p class="hero__interests">
      {
        profile.interests.map((interest) => (
          <span class="hero__interest">{interest}</span>
        ))
      }
    </p>

    <ul class="hero__links">
      {
        profile.links.map((link) => (
          <li>
            <a
              class="hero__link"
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
              {link.external && <Icon size={9} />}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="hero__plate">
    <Image
      src={profile.portrait.src}
      alt={profile.portrait.alt}
      width={128}
      height={128}
      densities={[1, 2]}
      format="webp"
      quality={84}
      priority
    />
  </div>
</header>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
  }

  .hero__plate {
    order: -1;
    width: 4.75rem;
    border: 1px solid var(--rule);
    padding: 0.25rem;
    background: var(--paper-hi);
  }

  .hero__plate :global(img) {
    width: 100%;
    height: auto;
  }

  .hero__role {
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .hero__name {
    margin-top: 0.55rem;
    font-size: var(--fs-name);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--ls-name);
  }

  .hero__affil {
    margin-top: 0.55rem;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .hero__bio {
    margin-top: 1.35rem;
    font-size: var(--fs-lead);
    line-height: 1.55;
    color: var(--ink-soft);
    max-width: 38rem;
  }

  .hero__interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.55rem;
    margin-top: 1.15rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.08em;
    color: var(--muted);
    line-height: 1.9;
  }

  .hero__interest:not(:last-child)::after {
    content: '·';
    margin-left: 0.55rem;
    color: var(--rule);
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.35rem;
    margin-top: 1.5rem;
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    letter-spacing: 0.05em;
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
    transition: color var(--fast) linear;
  }

  .hero__link:hover {
    color: var(--accent);
  }

  @media (min-width: 560px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) 8rem;
      gap: 2.5rem;
      align-items: start;
    }

    .hero__plate {
      order: 0;
      width: 8rem;
    }
  }
</style>
