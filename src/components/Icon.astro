---
interface Props {
  size?: number;
  class?: string;
}

const { size = 10, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  <path d="M7 17 17 7M9 7h8v8" />
</svg>
