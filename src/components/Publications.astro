---
import Block from './Block.astro';
import { paperList } from '../data';
import { statusLabel } from '../lib/format';
---

<Block id="publications" index="01" title="Publications" count={`${paperList.length} manuscripts`}>
  <ol class="rows">
    {
      paperList.map((paper) => (
        <li>
          <h3 class="pub__title">{paper.title}</h3>

          <ul class="pub__authors" aria-label="Authors">
            {paper.authors.map((author) => (
              <li class={author.self ? 'is-self' : undefined}>{author.name}</li>
            ))}
          </ul>

          <p class="mono pub__venue">
            {paper.venue} · {paper.publisher} · {statusLabel(paper.status)} · {paper.year}
          </p>
        </li>
      ))
    }
  </ol>
</Block>

<style>
  .pub__title {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.011em;
    color: var(--ink);
    text-wrap: pretty;
  }

  .pub__authors {
    margin-top: 0.2rem;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--muted);
  }

  .pub__authors li {
    display: inline;
  }

  .pub__authors li + li::before {
    content: ', ';
  }

  .pub__authors .is-self {
    color: var(--ink);
    font-weight: 600;
  }

  .pub__venue {
    margin-top: 0.3rem;
    line-height: 1.6;
  }
</style>
