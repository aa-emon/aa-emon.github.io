---
import Block from './Block.astro';
import { paperList } from '../data';
import { statusLabel } from '../lib/format';
---

<Block id="publications" index="04" title="Publications">
  <ol class="rows">
    {
      paperList.map((paper) => {
        const href = paper.url ?? (paper.doi ? `https://doi.org/${paper.doi}` : null);
        return (
        <li>
          <h3 class="pub__title">
            {href ? (
              <a class="pub__link" href={href} target="_blank" rel="noopener noreferrer">
                {paper.title}
              </a>
            ) : (
              paper.title
            )}
          </h3>

          <ul class="pub__authors" aria-label="Authors">
            {paper.authors.map((author) => (
              <li class={author.self ? 'is-self' : undefined}>{author.name}</li>
            ))}
          </ul>

          <p class="mono pub__venue">
            {paper.venue} · {paper.publisher} · {statusLabel(paper.status)} · {paper.year}
          </p>
        </li>
        );
      })
    }
  </ol>
</Block>

<style>
  .pub__title {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.011em;
    color: var(--ink);
    text-wrap: pretty;
  }

  .pub__link {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    transition:
      background-size var(--med) var(--ease),
      color var(--fast) linear;
  }

  .pub__link:hover {
    color: var(--accent);
  }

  .pub__authors {
    margin-top: 0.2rem;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--muted);
  }

  .pub__authors li {
    display: inline;
  }

  .pub__authors li + li::before {
    content: ', ';
  }

  .pub__authors .is-self {
    color: var(--ink);
    font-weight: 600;
  }

  .pub__venue {
    margin-top: 0.3rem;
    line-height: 1.6;
  }
</style>
