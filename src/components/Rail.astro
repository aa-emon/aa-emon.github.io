---
/**
 * Desktop spine: identity, page index, and the links that matter.
 * Sticky inside the shell grid (not `position: fixed`), so it can never
 * overlap content and needs no scroll listener to behave.
 */
import Icon from './Icon.astro';
import { navSections, profile } from '../data';

const year = new Date().getFullYear();
---

<aside class="rail" aria-label="Profile and page index">
  <a class="rail__mark" href="#profile">
    <span class="rail__monogram" aria-hidden="true">AE</span>
    <span class="rail__id">
      <span class="rail__name">{profile.name}</span>
      <span class="rail__role">{profile.headline}</span>
    </span>
  </a>
  <nav class="rail__nav" aria-label="Sections">
    <ol class="rail__list">
      {
        navSections.map((section) => (
          <li>
            <a href={`#${section.id}`} data-nav={section.id}>
              <span class="rail__num">{section.number}</span>
              <span class="rail__label">{section.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="rail__foot">
    <ul class="rail__links">
      {
        profile.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rail__link"
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              <span>{link.label}</span>
              {link.icon === 'arrow' && <Icon name="arrow" size={10} />}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="rail__year">{year}</p>
  </div>
</aside>

<style>
  .rail {
    display: none;
  }

  @media (min-width: 1080px) {
    .rail {
      display: flex;
      flex-direction: column;
      position: sticky;
      top: 0;
      align-self: start;
      height: 100dvh;
      padding: 2.25rem 1.25rem 1.75rem var(--gutter);
      border-right: 1px solid var(--rule);
      overflow-y: auto;
    }
  }

  .rail__mark {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .rail__monogram {
    display: grid;
    place-items: center;
    width: 2.125rem;
    height: 2.125rem;
    border: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--ink);
    flex: none;
  }

  .rail__id {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .rail__name {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
    line-height: 1.15;
    text-wrap: balance;
  }

  .rail__role {
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.5;
    max-width: 22ch;
  }

  .rail__nav {
    margin-top: 2.5rem;
  }

  .rail__list li + li {
    border-top: 1px solid var(--rule-soft);
  }

  .rail__list a {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.4rem 0;
    transition: color var(--fast) linear;
  }

  .rail__num {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    transition: color var(--fast) linear;
  }

  .rail__label {
    font-size: 0.8125rem;
    color: var(--muted);
    letter-spacing: -0.005em;
    transition: color var(--fast) linear;
  }

  .rail__list a:hover .rail__label,
  .rail__list a:hover .rail__num {
    color: var(--ink);
  }

  .rail__list a[aria-current='true'] .rail__num {
    color: var(--accent);
  }

  .rail__list a[aria-current='true'] .rail__label {
    color: var(--ink);
  }

  .rail__foot {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .rail__links {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.85rem;
  }

  .rail__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    transition: color var(--fast) linear;
  }

  .rail__link:hover {
    color: var(--accent);
  }

  .rail__year {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
</style>
