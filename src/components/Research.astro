---
/**
 * Research threads. Numbered rows on hairlines — no cards. Each thread links
 * back to the manuscript it produced, if any.
 */
import SectionHeader from './SectionHeader.astro';
import { paperLabel, researchThemes } from '../data';
---

<section id="research" aria-labelledby="research-heading">
  <div class="wrap">
    <SectionHeader
      id="research"
      title="Research"
      count={`${researchThemes.length} threads`}
      lead="Different methods, one question: what does it take for a learned model to be worth trusting outside the lab?"
    />

    <ol class="themes">
      {
        researchThemes.map((theme, index) => (
          <li class="theme">
            <span class="theme__index">{String(index + 1).padStart(2, '0')}</span>

            <div class="theme__body">
              <h3 class="theme__title">{theme.title}</h3>
              <p class="theme__summary">{theme.summary}</p>

              <div class="theme__foot">
                <p class="theme__keywords">{theme.keywords.join(' · ')}</p>

                {theme.paperIds && theme.paperIds.length > 0 && (
                  <p class="theme__papers">
                    <span class="theme__papers-label">Manuscript</span>
                    {theme.paperIds.map((id, i) => {
                      const label = paperLabel(id);
                      return (
                        <>
                          {i > 0 && ', '}
                          {label ? (
                            <a class="theme__paper" href="#publications">
                              {label}
                            </a>
                          ) : null}
                        </>
                      );
                    })}
                  </p>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .themes {
    border-bottom: 1px solid var(--rule);
  }

  .theme {
    display: grid;
    grid-template-columns: 1.9rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: clamp(1.5rem, 3vw, 2.1rem);
    border-top: 1px solid var(--rule);
    transition: border-color var(--med) var(--ease);
  }

  .theme__index {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    padding-top: 0.42rem;
    font-variant-numeric: tabular-nums;
    transition: color var(--fast) linear;
  }

  .theme:hover .theme__index {
    color: var(--accent);
  }

  .theme__body {
    min-width: 0;
  }

  .theme__title {
    font-size: clamp(1.125rem, 1.55vw, 1.3125rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--ink);
  }

  .theme__summary {
    margin-top: 0.55rem;
    max-width: 58ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-soft);
    text-wrap: pretty;
  }

  .theme__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1.5rem;
    margin-top: 0.9rem;
  }

  .theme__keywords {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    line-height: 1.6;
  }

  .theme__papers {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .theme__papers-label {
    text-transform: uppercase;
    letter-spacing: 0.09em;
    margin-right: 0.45rem;
    color: var(--rule);
  }

  .theme__paper {
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1px;
    transition: color var(--fast) linear;
  }

  .theme__paper:hover {
    color: var(--accent);
  }

  @media (min-width: 640px) {
    .theme {
      grid-template-columns: 3rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }
</style>
