---
/**
 * One header shape for every section: index number on the baseline of the
 * title, optional count and lead in a narrow right column.
 */
import type { SectionId } from '../lib/types';
import { sectionNumber } from '../data';

interface Props {
  id: SectionId;
  title: string;
  /** Short paragraph on the right, e.g. a scope note. */
  lead?: string;
  /** Small mono figure on the right, e.g. "3 manuscripts". */
  count?: string;
}

const { id, title, lead, count } = Astro.props;
const number = sectionNumber(id);
---

<header class="shead" data-reveal="rise">
  <div class="shead__main">
    <span class="shead__num">{number}</span>
    <h2 class="shead__title" id={`${id}-heading`}>{title}</h2>
  </div>

  {
    (lead || count) && (
      <div class="shead__aside">
        {count && <p class="shead__count">{count}</p>}
        {lead && <p class="shead__lead">{lead}</p>}
      </div>
    )
  }
</header>

<style>
  .shead {
    display: grid;
    gap: 1rem;
    margin-bottom: clamp(2.25rem, 4.5vw, 3.75rem);
  }

  .shead__main {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }

  .shead__num {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: 0.06em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    flex: none;
  }

  .shead__title {
    font-size: var(--fs-h2);
  }

  .shead__aside {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .shead__count {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    letter-spacing: var(--ls-meta);
    text-transform: uppercase;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .shead__lead {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--muted);
    max-width: 34ch;
    text-wrap: pretty;
  }

  @media (min-width: 860px) {
    .shead {
      grid-template-columns: minmax(0, 1fr) minmax(0, 19rem);
      gap: 3rem;
      align-items: end;
    }

    .shead__aside {
      align-items: flex-start;
      padding-bottom: 0.35rem;
    }
  }
</style>
