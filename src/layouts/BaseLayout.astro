---
/**
 * Document shell: metadata, fonts, one centred column. No navigation, no
 * client-side JavaScript — the page is a single screen of type.
 */
import { Font, getImage } from 'astro:assets';
import '../styles/base.css';
import Background from '../components/Background.astro';
import Footer from '../components/Footer.astro';
import { profile, site } from '../data';

const canonical = new URL(Astro.url.pathname, site.url).href;
const base = import.meta.env.BASE_URL;

const social = await getImage({
  src: profile.portrait.src,
  width: 500,
  height: 500,
  format: 'jpeg',
  fit: 'cover',
  quality: 82,
});
const socialUrl = new URL(social.src, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: profile.name,
      url: site.url,
      image: socialUrl,
      email: `mailto:${site.email}`,
      jobTitle: 'MSc Candidate in Computer Science',
      description: site.description,
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: 'Shandong University of Science and Technology',
      },
      alumniOf: {
        '@type': 'CollegeOrUniversity',
        name: 'Shandong University of Science and Technology',
      },
      sameAs: profile.sameAs,
      knowsAbout: profile.interests,
    },
    {
      '@type': 'ProfilePage',
      '@id': `${site.url}/#page`,
      url: site.url,
      name: site.title,
      isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
      about: { '@id': `${site.url}/#person` },
      inLanguage: 'en',
    },
  ],
};
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f6f4ef" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialUrl} />
    <meta property="og:image:width" content="500" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:alt" content={profile.name} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={socialUrl} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>

  <body>
    <Background />

    <main class="page" id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

