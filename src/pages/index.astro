---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Education from '../components/Education.astro';
import Lab from '../components/Lab.astro';
import Awards from '../components/Awards.astro';
import Publications from '../components/Publications.astro';
import Service from '../components/Service.astro';
import Contact from '../components/Contact.astro';

import { awards, education, labs, publications, service } from '../data';
---

<BaseLayout>
  <Hero />

  {education.length > 0 && <Education />}
  {labs.length > 0 && <Lab />}
  {awards.length > 0 && <Awards />}
  {publications.length > 0 && <Publications />}
  {service.length > 0 && <Service />}

  <Contact />
</BaseLayout>
